# Neon Postgres — connection string do dashboard do projeto.
DATABASE_URL=""

# Better Auth — chave secreta (mínimo 32 caracteres, alta entropia).
# Gerar com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL base da aplicação usada pelo Better Auth.
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary — upload da foto de perfil do usuário.
# Painel: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""
